DATA_DIR=./data
HOST=127.0.0.1
PORT=3000
AUTH_BASE_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
MCP_RESOURCE=http://127.0.0.1:3000/mcp
MCP_PROTOCOL_VERSION=2026-07-28
ALLOWED_HOSTS=127.0.0.1,localhost
ALLOWED_ORIGIN_HOSTS=127.0.0.1,localhost
TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Used only when running `bun run auth:bootstrap`.
AUTH_BOOTSTRAP_EMAIL=owner@example.com
AUTH_BOOTSTRAP_PASSWORD=replace-with-a-password-of-at-least-12-characters
AUTH_BOOTSTRAP_NAME=Owner
